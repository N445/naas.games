SHELL := /bin/bash
ENV_FILES := --env-file .env $(if $(wildcard .env.local),--env-file .env.local)
DC := docker compose $(ENV_FILES)
# Déployé sous le nom `Makefile` : la récursion ne doit pas coder `-f Makefile.prod` en dur.
THIS_MAKEFILE := $(firstword $(MAKEFILE_LIST))

.PHONY: up down logs sh update cache-clear backup

up:
	@mkdir -p var storage/screenshots public/media/cache
	$(DC) up -d

down:
	$(DC) down

logs:
	$(DC) logs -f

sh:
	$(DC) exec naas-games-php bash

update:
	$(DC) up -d --wait database
	$(MAKE) -f $(THIS_MAKEFILE) backup
	$(DC) pull naas-games-php vision
	$(MAKE) -f $(THIS_MAKEFILE) up
	$(DC) exec -T naas-games-php bin/console doctrine:migrations:migrate -n --allow-no-migration
	$(DC) exec -T naas-games-php bin/console cache:warmup

# Le worker FrankenPHP garde le noyau en mémoire : sans redémarrage, l'ancien cache reste servi.
cache-clear:
	$(DC) exec -T naas-games-php bin/console cache:pool:clear --all
	$(DC) exec -T naas-games-php bin/console cache:clear
	$(DC) restart naas-games-php

BACKUP_DIR  ?= backups
BACKUP_DAYS ?= 14
backup:
	@mkdir -p $(BACKUP_DIR)
	set -o pipefail; stamp=$$(date +%F-%H%M%S); \
	$(DC) exec -T database sh -c 'mariadb-dump -uroot -p"$$MARIADB_ROOT_PASSWORD" --single-transaction --routines "$$MARIADB_DATABASE"' \
	  | gzip > $(BACKUP_DIR)/db-$$stamp.sql.gz
	find $(BACKUP_DIR) -name '*.gz' -mtime +$(BACKUP_DAYS) -delete
