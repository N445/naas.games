{% set original = entity.instance %}
{% set lightbox_id = 'ea-lightbox-' ~ field.uniqueId %}
<a href="{{ original.path|imagine_filter('screenshot_preview') }}" class="ea-lightbox-thumbnail screenshot-thumbnail screenshot-thumbnail--panoramic" data-ea-lightbox-content-selector="#{{ lightbox_id }}">
    <img src="{{ original.path|imagine_filter('screenshot_thumbnail') }}" alt="{{ original.file.originalName }}" loading="lazy">
    {% if original.pending %}<span class="screenshot-thumbnail__flag" title="En attente de son final"><i class="fa fa-hourglass-half"></i></span>{% endif %}
</a>
<div id="{{ lightbox_id }}" class="ea-lightbox">
    <img src="{{ original.path|imagine_filter('screenshot_preview') }}" alt="{{ original.file.originalName }}" loading="lazy">
</div>
