{% set screenshot = entity.instance %}
{% set lightbox_id = 'ea-lightbox-' ~ field.uniqueId %}
<a href="{{ screenshot.path|imagine_filter('screenshot_preview') }}" class="ea-lightbox-thumbnail screenshot-thumbnail" data-ea-lightbox-content-selector="#{{ lightbox_id }}">
    <img src="{{ screenshot.path|imagine_filter('screenshot_thumbnail') }}" alt="{{ screenshot.title }}" loading="lazy">
    {% if not screenshot.published %}<span class="screenshot-thumbnail__flag"><i class="fa fa-eye-slash"></i></span>{% endif %}
</a>
<div id="{{ lightbox_id }}" class="ea-lightbox">
    <img src="{{ screenshot.path|imagine_filter('screenshot_preview') }}" alt="{{ screenshot.title }}" loading="lazy">
</div>
